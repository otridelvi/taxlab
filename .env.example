# Copy to .env.local and fill in. Never commit real values.

# Supabase · Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# sit | production
APP_ENV=sit
APP_BASE_URL=http://localhost:3000

# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# Keep-alive (GET /api/health, Bearer token). 16+ random characters: openssl rand -hex 24
# Same value goes into the GitHub secret HEALTHCHECK_TOKEN_SIT. Optional locally.
HEALTHCHECK_TOKEN=
